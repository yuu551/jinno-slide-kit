{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarpKit",
  "version": "0.1.0",
  "identifier": "jp.jinno.marp-kit",
  "build": {
    "runner": { "cmd": "cargo", "args": ["--locked"] },
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/package-app.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; frame-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "resources/kit/": "kit/"
    },
    "fileAssociations": [
      {
        "ext": [
          "md"
        ],
        "name": "Marp スライド",
        "description": "Marp のスライド（slides.md）",
        "role": "Editor",
        "mimeType": "text/markdown",
        "rank": "Alternate",
        "contentTypes": [
          "net.daringfireball.markdown"
        ]
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
